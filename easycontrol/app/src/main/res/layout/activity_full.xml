<?xml version="1.0" encoding="utf-8"?><!-- 投屏全屏页（竖屏）：视频画面 + 底部导航栏(可隐藏) + 悬浮按钮(打开控制面板) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blackBacnground"
    android:keepScreenOn="true"
    tools:context=".client.view.FullActivity">

    <EditText
        android:id="@+id/edit_text"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:inputType="textVisiblePassword" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- FrameLayout 以便绝对定位虚拟鼠标光标覆盖层；gravity=center 保持画面居中 -->
        <FrameLayout
            android:id="@+id/texture_view_layout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center" />

        <LinearLayout
            android:id="@+id/nav_bar"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/background_client_nav"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/button_back"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/background_client_button"
                android:focusable="false"
                android:padding="12dp"
                android:src="@drawable/caret_left"
                app:tint="@color/clientNavIcon" />

            <ImageView
                android:id="@+id/button_home"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/background_client_button"
                android:focusable="false"
                android:padding="12dp"
                android:src="@drawable/o"
                app:tint="@color/clientNavIcon" />

            <ImageView
                android:id="@+id/button_switch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/background_client_button"
                android:focusable="false"
                android:padding="12dp"
                android:src="@drawable/square"
                app:tint="@color/clientNavIcon" />

        </LinearLayout>
    </LinearLayout>

    <!-- 悬浮按钮：始终在，可拖动，松手贴边，闲置变淡；位置由代码设置 -->
    <ImageView
        android:id="@+id/button_float"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|left"
        android:background="@drawable/background_client_float"
        android:focusable="false"
        android:padding="12dp"
        android:src="@drawable/apps"
        app:tint="@color/onBlackBacnground" />
</FrameLayout>
